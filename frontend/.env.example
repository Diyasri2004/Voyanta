# ─────────────────────────────────────────────────────────────
# VOYANTA Frontend — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local!
# ─────────────────────────────────────────────────────────────

# Pexels API key (server-side only — never exposed to browser)
# Get your key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Backend URL — your Render service URL after deployment
# Example: https://voyanta-backend.onrender.com
VOYANTA_BACKEND_URL=https://your-backend.onrender.com
