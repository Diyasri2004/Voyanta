# ─────────────────────────────────────────────────────────────
# VOYANTA — Frontend Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Pexels API key — used SERVER-SIDE only (never exposed to the browser)
# Get your key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Optional: override the backend URL (default: auto-detected on localhost 8000-8005)
# VOYANTA_BACKEND_URL=https://your-backend.railway.app
