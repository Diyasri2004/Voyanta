# ─────────────────────────────────────────────────────────────
# VOYANTA Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env!
# ─────────────────────────────────────────────────────────────

# PostgreSQL — Supabase, Neon, or any Postgres provider
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# TomTom Maps API — https://developer.tomtom.com/
TOMTOM_API_KEY="your_tomtom_api_key"

# OpenWeatherMap — https://openweathermap.org/api
OPENWEATHER_API_KEY="your_openweather_api_key"

# Pexels — https://www.pexels.com/api/
PEXELS_API_KEY="your_pexels_api_key"

# Groq (free hosted AI) — https://console.groq.com/keys
# Replaces local Ollama; works on Render/Vercel with no extra setup
GROQ_API_KEY="your_groq_api_key"
GROQ_MODEL="llama3-8b-8192"

# CORS — comma-separated list of allowed frontend origins
# Example: https://voyanta.vercel.app
# Use * only for local development
CORS_ORIGINS="http://localhost:3000"

# AI providers (Groq is tried first, then OpenRouter/Gemini)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
UNSPLASH_ACCESS_KEY=

# Real events (the Events tab only shows verified results from these)
# Ticketmaster Discovery API (free, 5000 calls/day) - https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
# SerpApi Google Events (free tier: 100 searches/month) - https://serpapi.com/
SERPAPI_KEY=
